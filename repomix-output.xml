              {/* Available Rewards */}
              <Card className="rounded-xl border border-gray-100 bg-white shadow-lg md:col-span-2">
                <div className="p-4 sm:p-6">
                  <h3 className="mb-3 text-xl font-extrabold text-gray-800 sm:mb-4 sm:text-2xl">

          </TabsContent>

          {/* Admin Login Form */}
          <TabsContent value="admin" className="p-6 pt-4">
            <form onSubmit={handleAdminSignIn}>
              <div className="space-y-4">
                <div className="space-y-2">
                  <label
                    htmlFor="admin-id"

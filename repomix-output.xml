  celery_worker:
    build: ./backend
    command: ["celery", "-A", "celery_app.app", "worker", "--loglevel=info"]
    networks:
      - backend-network
    environment:
      - MONGO_URI=mongodb://mongodb:27017/gc25
      - REDIS_URL=redis://redis-main:6379/0
    env_file:
      - .env
    depends_on:
      redis-main:
        condition: service_healthy
      mongodb:
        condition: service_started
      backend:
        condition: service_started

  celery_beat:
    build: ./backend
    command: ["celery", "-A", "celery_app.app", "beat", "--loglevel=info"]
    networks:
      - backend-network
    environment:
      - MONGO_URI=mongodb://mongodb:27017/gc25
      - REDIS_URL=redis://redis-main:6379/0
    env_file:
      - .env
    depends_on:
      redis-main:
        condition: service_healthy
      mongodb:
        condition: service_started
      backend:
        condition: service_started

  frontend:
    build: 

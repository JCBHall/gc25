                  </p>
                  <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
                    <AnimatePresence>
                      {profile.avaiableRewards.map((reward) => (
                        <motion.div
                          key={reward.id}
                          layout
                          initial={{ opacity: 0, scale: 0.8 }}
                          animate={{ opacity: 1, scale: 1 }}
                          exit={{
                            opacity: 0,
                            scale: 0.8,
                            y: -50,
                            transition: { duration: 0.5 },
